# MediStock Production Environment Variables Example
# Copy this to .env and change values for production

# Database Configuration
DB_NAME=medistock_db
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_URL=jdbc:postgresql://db:5432/medistock_db

# Security
# MUST change this to a secure random 256-bit key for production!
JWT_SECRET=super_secret_jwt_key_that_is_long_enough_to_be_secure_for_hmac
JWT_EXPIRATION=86400000

# Other parameters
# FRONTEND_URL=https://your-domain.com

# ─── Email Alerts ──────────────────────────────────────────────────────────────
# Set EMAIL_ALERTS_ENABLED=true to send low-stock and expiry emails
EMAIL_ALERTS_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
# Use an App Password for Gmail (not your account password)
MAIL_PASSWORD=your-16-char-app-password
